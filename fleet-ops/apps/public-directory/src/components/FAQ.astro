---
import { PACKAGE_HOST } from '../data/links';

const FAQ = [
  {
    q: 'What is SaaS Maker?',
    a: 'SaaS Maker is a public directory for Sarthak Agrawal’s maintained products and the home of the @saas-maker/feedback package. It links each product to its canonical site, repository, changelog, and roadmap without merging their identities or release boundaries.',
  },
  {
    q: 'What does the feedback package do?',
    a: 'The React package collects bugs, feature requests, general feedback, screenshots, and optional page-element context. It calls the product’s required onSubmit callback and contains no hosted endpoint, project key, storage, or inbox.',
  },
  {
    q: 'How current is the directory?',
    a: 'The directory is rebuilt from the same public metadata used to track each product. That keeps names, canonical sites, repositories, changelogs, and roadmaps aligned without exposing private operational data.',
  },
  {
    q: 'Why do products keep separate sites?',
    a: 'Each product has its own audience and release boundary. SaaS Maker is the map: it helps visitors discover the work, then sends them to the product’s canonical home.',
  },
  {
    q: 'Where are the package docs?',
    a: `The npm page at ${PACKAGE_HOST} renders the package README with installation, callback, payload, Pinpoint, screenshot, compatibility, and privacy guidance. No separate documentation site is required.`,
  },
];

const FAQ_JSONLD = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: FAQ.map(({ q, a }) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: { '@type': 'Answer', text: a },
  })),
};
---

<section class="section faq" id="faq">
  <div class="section-head">
    <div class="section-marker">
      <span class="section-num">§ 03</span>
      <span class="section-rule"></span>
      <span class="section-kw">Field Notes</span>
    </div>
    <h2 class="section-title">
      Frequently asked,
      <br />
      <em class="italic">straight answers.</em>
    </h2>
    <p class="section-lede">
      The boundary is intentionally small: a directory and one package.
    </p>
  </div>

  <div class="faq-list">
    {FAQ.map(({ q, a }, i) => (
      <details class="faq-item" open={i === 0}>
        <summary class="faq-q">
          <span class="faq-q-num">{String(i + 1).padStart(2, '0')}</span>
          <span class="faq-q-text">{q}</span>
          <span class="faq-q-mark" aria-hidden="true">+</span>
        </summary>
        <p class="faq-a">{a}</p>
      </details>
    ))}
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(FAQ_JSONLD)} />
</section>
