{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fleet.local/schemas/turso-d1-migration-receipt.v1.json",
  "title": "Fleet Turso to D1 migration receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "projectId",
    "mode",
    "authority",
    "source",
    "target",
    "schemaChecks",
    "dataChecks",
    "journeyChecks",
    "timings",
    "approval",
    "rollback",
    "result"
  ],
  "properties": {
    "schemaVersion": { "const": "turso-d1-migration-receipt.v1" },
    "projectId": { "type": "string", "minLength": 1 },
    "mode": { "enum": ["cutover", "reconciliation"] },
    "authority": {
      "enum": ["turso", "d1-prepared", "d1", "rollback-held"]
    },
    "source": { "$ref": "#/$defs/databaseRef" },
    "target": { "$ref": "#/$defs/databaseRef" },
    "schemaChecks": {
      "type": "array",
      "items": { "$ref": "#/$defs/check" }
    },
    "dataChecks": {
      "type": "array",
      "items": { "$ref": "#/$defs/check" }
    },
    "journeyChecks": {
      "type": "array",
      "items": { "$ref": "#/$defs/check" }
    },
    "timings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observedAt", "rehearsalMs", "writeFreezeMs"],
      "properties": {
        "observedAt": { "type": "string", "format": "date-time" },
        "rehearsalMs": { "type": ["integer", "null"], "minimum": 0 },
        "writeFreezeMs": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["remoteMutationApproved", "cutoverApproved", "retirementApproved"],
      "properties": {
        "remoteMutationApproved": { "type": "boolean" },
        "cutoverApproved": { "type": "boolean" },
        "retirementApproved": { "type": "boolean" }
      }
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourcePreserved", "releaseAvailable", "reconciliationRequired"],
      "properties": {
        "sourcePreserved": { "type": "boolean" },
        "releaseAvailable": { "type": "boolean" },
        "reconciliationRequired": { "type": "boolean" }
      }
    },
    "result": { "enum": ["pass", "fail", "blocked", "not-run"] },
    "notes": {
      "type": "array",
      "items": { "type": "string", "maxLength": 500 }
    }
  },
  "$defs": {
    "databaseRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "name", "role"],
      "properties": {
        "provider": { "enum": ["turso", "cloudflare-d1", "none"] },
        "name": { "type": ["string", "null"] },
        "role": { "enum": ["authoritative", "prepared", "rollback-held", "none"] },
        "schemaRevision": { "type": ["string", "null"] },
        "sizeBytes": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "sourceValue", "targetValue"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "status": { "enum": ["pass", "fail", "blocked", "not-applicable"] },
        "sourceValue": { "type": ["string", "number", "boolean", "null"] },
        "targetValue": { "type": ["string", "number", "boolean", "null"] },
        "detail": { "type": "string", "maxLength": 500 }
      }
    }
  }
}

