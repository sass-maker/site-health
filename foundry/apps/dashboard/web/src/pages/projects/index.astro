---
import DashboardLayout from "../../components/DashboardLayout.astro";
---

<DashboardLayout
  title="Projects"
  description="Every project, with its current record, changelog, and source."
  active="projects"
  view="projects"
>
  <span slot="meta" class="snapshot-time" data-project-status-time>Reading project directory</span>
  <section class="owner-section owner-section--directory" aria-label="Project directory">
    <div class="loading-state" data-dashboard-slot="project-statuses">Building project directory…</div>
  </section>
</DashboardLayout>
