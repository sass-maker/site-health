---
import FounderLayout from "../components/FounderLayout.astro";
---

<FounderLayout
  title="AI Awareness"
  description="Provider-backed visibility outcomes for maintained P1 product-category projects."
  active="ai-awareness"
  view="ai-awareness"
>
  <div slot="meta" class="page-head__meta">
    <span class="snapshot-time" data-connections-time>Reading provider evidence</span>
  </div>

  <section class="owner-section owner-section--directory" aria-labelledby="ai-awareness-title">
    <div class="section-head">
      <div>
        <h2 id="ai-awareness-title">Core product awareness</h2>
        <p>Missing provider observations stay visibly unmeasured; readiness scores are not substituted.</p>
      </div>
      <span class="count" data-founder-count="ai-awareness">—</span>
    </div>
    <div class="loading-state" data-founder-slot="ai-awareness">Building the awareness directory…</div>
  </section>
</FounderLayout>
