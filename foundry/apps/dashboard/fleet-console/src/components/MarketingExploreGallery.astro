---
const serviceOrigin = import.meta.env.PUBLIC_REEL_PIPELINE_ORIGIN ?? "http://127.0.0.1:4317";
---

<!--
THESIS: Real output leads; backend names cannot stand in for visual quality.
OWN-WORLD: The existing near-black Foundry workspace, hairline divisions, mint actions, and candid state language frame edge-to-edge moving artifacts.
STORY: Scan distinct visual families, inspect how each sample was made, then carry one exact reproducible preset into the existing maker.
FIRST VIEWPORT: A compact title and filter rail sit above two wide lead films; provenance remains below the work, never over it.
FORM: Style-first film contact sheet inside the established Console shell; preserve-mode Experience surface with no alternate visual identity.
-->
<section
  class="explore-gallery"
  aria-label="Video capability proofs"
  data-explore-gallery
  data-service-origin={serviceOrigin}
>
  <div class="gallery-controls">
    <div class="gallery-summary">
      <div class="gallery-tally" aria-live="polite">
        <strong data-gallery-count>—</strong>
        <span>capabilities proven</span>
        <small><span data-gallery-proof-count>—</span> demos across the proven capabilities · <span data-gallery-option-count>—</span> exact maker options</small>
      </div>
      <details class="gallery-coverage" data-gallery-coverage hidden>
        <summary data-gallery-coverage-summary>Coverage gap</summary>
        <p data-gallery-coverage-note></p>
      </details>
    </div>
    <div class="gallery-filters" aria-label="Filter video styles" data-gallery-filters>
      <button type="button" aria-pressed="true" data-gallery-family="all">All styles</button>
    </div>
    <label class="gallery-filter-select">
      <span>Show</span>
      <select id="gallery-style-filter" name="gallery-style-filter" data-gallery-filter-select aria-label="Filter video styles">
        <option value="all">All styles</option>
      </select>
    </label>
    <p class="gallery-result-count" data-gallery-result-count>Loading the local gallery…</p>
  </div>

  <aside class="gallery-mix" data-gallery-mix hidden aria-labelledby="gallery-mix-title">
    <div class="gallery-mix__copy">
      <strong id="gallery-mix-title">Style mix <span data-gallery-mix-count>0/3</span></strong>
      <p>Choose a base, then add up to two influences.</p>
      <div class="gallery-mix__chips" data-gallery-mix-chips></div>
      <p class="gallery-mix__status" data-gallery-mix-status aria-live="polite"></p>
    </div>
    <div class="gallery-mix__actions">
      <button type="button" data-gallery-mix-clear>Clear</button>
      <button type="button" class="gallery-mix__primary" data-gallery-mix-use disabled>Use this mix</button>
    </div>
  </aside>

  <div class="gallery-state" role="status" aria-live="polite" data-gallery-state>
    Reading playable evidence from Reel Pipeline…
  </div>
  <p class="gallery-announcer" aria-live="polite" data-gallery-announcer></p>
  <div class="gallery-grid" data-gallery-grid hidden></div>
</section>

<script>
  type GalleryItem = {
    id: string;
    recipeId: string;
    proofRole: "primary" | "range";
    rangeLabel: string;
    motionTags: string[];
    title: string;
    family: string;
    description: string;
    engine: string;
    sourcePosture: string;
    qualityTier: "showcase" | "experiment" | "baseline";
    spend: string;
    variantId: string;
    prompt: string;
    renderer: string;
    intendedRuntime: string;
    executionMode: "fixture" | "real";
    playable: boolean;
    mediaUrl: string | null;
    posterUrl: string | null;
    durationSeconds: number;
  };

  type Gallery = {
    count: number;
    playableCount: number;
    exactOptionCount: number;
    totalCapabilityCount: number;
    provenCapabilityCount: number;
    proofCount: number;
    unproven: Array<{ recipeId: string; reason: string }>;
    families: string[];
    items: GalleryItem[];
  };

  const postureLabels: Record<string, string> = {
    fixture: "Rights-safe fixture",
    "local-render": "Local render",
    "specialist-proof": "Specialist proof",
    "local-model-proof": "Local model proof",
    "baseline-local": "Local baseline",
    "baseline-import": "Imported baseline",
    "external-continuation": "External continuation",
  };

  for (const root of document.querySelectorAll<HTMLElement>("[data-explore-gallery]")) {
    const serviceOrigin = root.dataset.serviceOrigin ?? "http://127.0.0.1:4317";
    const filters = root.querySelector<HTMLElement>("[data-gallery-filters]")!;
    const filterSelect = root.querySelector<HTMLSelectElement>("[data-gallery-filter-select]")!;
    const grid = root.querySelector<HTMLElement>("[data-gallery-grid]")!;
    const state = root.querySelector<HTMLElement>("[data-gallery-state]")!;
    const count = root.querySelector<HTMLElement>("[data-gallery-count]")!;
    const optionCount = root.querySelector<HTMLElement>("[data-gallery-option-count]")!;
    const proofCount = root.querySelector<HTMLElement>("[data-gallery-proof-count]")!;
    const announcer = root.querySelector<HTMLElement>("[data-gallery-announcer]")!;
    const coverage = root.querySelector<HTMLDetailsElement>("[data-gallery-coverage]")!;
    const coverageSummary = root.querySelector<HTMLElement>("[data-gallery-coverage-summary]")!;
    const coverageNote = root.querySelector<HTMLElement>("[data-gallery-coverage-note]")!;
    const resultCount = root.querySelector<HTMLElement>("[data-gallery-result-count]")!;
    const mixTray = root.querySelector<HTMLElement>("[data-gallery-mix]")!;
    const mixCount = root.querySelector<HTMLElement>("[data-gallery-mix-count]")!;
    const mixChips = root.querySelector<HTMLElement>("[data-gallery-mix-chips]")!;
    const mixUse = root.querySelector<HTMLButtonElement>("[data-gallery-mix-use]")!;
    const mixClear = root.querySelector<HTMLButtonElement>("[data-gallery-mix-clear]")!;
    const mixStatus = root.querySelector<HTMLElement>("[data-gallery-mix-status]")!;
    let gallery: Gallery | null = null;
    let activeFamily = "all";
    let selectedMix: GalleryItem[] = [];

    function labelFor(value: string) {
      return postureLabels[value] ?? value.split("-").map((part) => part ? part[0].toUpperCase() + part.slice(1) : part).join(" ");
    }

    function element<K extends keyof HTMLElementTagNameMap>(name: K, className?: string) {
      const node = document.createElement(name);
      if (className) node.className = className;
      return node;
    }

    function metadata(term: string, value: string) {
      const group = element("div");
      const dt = element("dt");
      const dd = element("dd");
      dt.textContent = term;
      dd.textContent = value;
      group.append(dt, dd);
      return group;
    }

    function actionFor(item: GalleryItem) {
      if (!item.playable) {
        const status = element("span", "gallery-card__note");
        status.textContent = "Sample unavailable on this machine";
        return status;
      }
      const link = element("a", "gallery-card__action");
      const params = new URLSearchParams({ variant: item.variantId, prompt: item.prompt });
      link.href = `/marketing?${params.toString()}#marketing-create-title`;
      link.textContent = item.qualityTier === "showcase" ? "Use this style" : "Try this experiment";
      return link;
    }

    function mixActionFor(item: GalleryItem) {
      const button = element("button", "gallery-card__mix");
      button.type = "button";
      button.dataset.mixVariant = item.variantId;
      button.setAttribute("aria-pressed", "false");
      button.disabled = !item.playable;
      button.textContent = item.playable ? "Set as base" : "Mix unavailable";
      button.addEventListener("click", () => toggleMix(item));
      return button;
    }

    function cardFor(item: GalleryItem) {
      const card = element("article", "gallery-card");
      card.dataset.family = item.family;
      card.dataset.quality = item.qualityTier;
      card.dataset.proofRole = item.proofRole;
      if (item.proofRole === "primary") card.classList.add("gallery-card--primary");

      const media = element("div", "gallery-card__media");
      if (item.playable && item.mediaUrl) {
        const video = element("video");
        video.controls = false;
        video.playsInline = true;
        video.preload = "none";
        video.dataset.src = serviceOrigin + item.mediaUrl;
        if (item.posterUrl) video.poster = serviceOrigin + item.posterUrl;
        video.setAttribute("aria-label", `${item.title} sample video`);
        const play = element("button", "gallery-card__play");
        play.type = "button";
        play.setAttribute("aria-label", `Preview ${item.title} sample video`);
        play.textContent = "▶ Preview";
        const previewStatus = element("p", "gallery-card__preview-status");
        previewStatus.hidden = true;
        previewStatus.setAttribute("aria-live", "polite");
        const showPreviewFailure = () => {
          video.controls = false;
          play.hidden = false;
          play.textContent = "↻ Retry preview";
          previewStatus.hidden = false;
          previewStatus.textContent = "Preview could not start. Try again.";
          announcer.textContent = `${item.title} preview could not start. Try again.`;
        };
        play.addEventListener("click", async () => {
          if (!video.src && video.dataset.src) {
            video.src = video.dataset.src;
            delete video.dataset.src;
            video.load();
          }
          video.controls = true;
          play.hidden = true;
          previewStatus.hidden = true;
          try {
            await video.play();
          } catch {
            showPreviewFailure();
          }
        });
        video.addEventListener("play", () => {
          play.hidden = true;
          play.textContent = "▶ Preview";
          previewStatus.hidden = true;
          for (const other of grid.querySelectorAll<HTMLVideoElement>("video")) {
            if (other !== video) other.pause();
          }
        });
        video.addEventListener("ended", () => {
          video.controls = false;
          play.hidden = false;
        });
        video.addEventListener("error", showPreviewFailure);
        media.append(video, play, previewStatus);
      } else {
        const unavailable = element("div", "gallery-card__unavailable");
        unavailable.innerHTML = "<strong>Not on this machine</strong><span>The registry is intact; the local artifact is missing.</span>";
        media.append(unavailable);
      }

      const copy = element("div", "gallery-card__copy");
      const head = element("div", "gallery-card__head");
      const family = element("span", "gallery-card__family");
      family.textContent = item.rangeLabel;
      head.append(family);
      if (item.qualityTier !== "showcase") {
        const quality = element("span", "gallery-card__quality");
        quality.textContent = item.qualityTier === "experiment" ? "Lab proof" : "Baseline";
        head.append(quality);
      }
      const title = element("h3");
      title.textContent = item.title;
      const description = element("p");
      description.textContent = item.description;
      const motion = element("div", "gallery-card__motion");
      motion.setAttribute("aria-label", "Motion and visual traits");
      motion.replaceChildren(...item.motionTags.map((tag) => {
        const label = element("span");
        label.textContent = labelFor(tag);
        return label;
      }));
      const provenance = element("details", "gallery-card__provenance");
      const provenanceSummary = element("summary");
      provenanceSummary.textContent = "How this was made";
      const details = element("dl");
      details.append(
        metadata("Renderer", item.renderer),
        metadata("Runs with", item.intendedRuntime),
        metadata("Duration", `${Math.round(item.durationSeconds * 10) / 10}s`),
        metadata("Quality", labelFor(item.qualityTier)),
        metadata("Source", labelFor(item.sourcePosture)),
        metadata("Cost", item.spend),
      );
      provenance.append(provenanceSummary, details);
      const footer = element("div", "gallery-card__footer");
      footer.append(actionFor(item), mixActionFor(item));
      copy.append(head, title, description, motion, provenance, footer);
      card.append(media, copy);
      return card;
    }

    function groupFor(items: GalleryItem[]) {
      const ordered = [...items].sort((a, b) => Number(b.proofRole === "primary") - Number(a.proofRole === "primary"));
      const group = element("section", "gallery-group");
      group.dataset.family = ordered[0].family;
      group.dataset.proofCount = String(ordered.length);
      const header = element("header", "gallery-group__header");
      const headingCopy = element("div", "gallery-group__heading");
      const heading = element("h2");
      heading.textContent = ordered[0].family;
      const summary = element("p");
      summary.textContent = ordered.length === 1
        ? `${ordered[0].engine} · ${ordered[0].qualityTier === "showcase" ? "one reviewed showcase proof" : "one reviewed lab proof"}`
        : `${ordered.length} materially different proofs · ${ordered[0].engine}`;
      const rangeCue = element("span", "gallery-group__range-cue");
      rangeCue.textContent = ordered.length === 1
        ? ordered[0].qualityTier === "showcase" ? "Showcase proof" : "Lab proof"
        : `Swipe through ${ordered.length} proofs`;
      headingCopy.append(heading, summary, rangeCue);
      const rail = element("div", "gallery-group__rail");
      rail.dataset.count = String(ordered.length);
      rail.setAttribute("aria-label", `${ordered[0].family} proof range`);
      rail.replaceChildren(...ordered.map(cardFor));
      const controls = element("div", "gallery-group__controls");
      if (ordered.length > 1) {
        const previous = element("button");
        const progress = element("span", "gallery-group__progress");
        const next = element("button");
        let currentIndex = 0;
        let frame = 0;
        previous.type = "button";
        previous.textContent = "←";
        previous.setAttribute("aria-label", `Previous ${ordered[0].family} proof`);
        next.type = "button";
        next.textContent = "→";
        next.setAttribute("aria-label", `Next ${ordered[0].family} proof`);
        const updateControls = () => {
          const cards = [...rail.querySelectorAll<HTMLElement>(".gallery-card")];
          const railLeft = rail.getBoundingClientRect().left;
          currentIndex = cards.reduce((nearest, card, index) =>
            Math.abs(card.getBoundingClientRect().left - railLeft) < Math.abs(cards[nearest].getBoundingClientRect().left - railLeft) ? index : nearest
          , 0);
          progress.textContent = `${currentIndex + 1} of ${ordered.length}`;
          previous.disabled = currentIndex === 0;
          next.disabled = currentIndex === ordered.length - 1;
        };
        const showCard = (index: number) => {
          const cards = [...rail.querySelectorAll<HTMLElement>(".gallery-card")];
          const card = cards[Math.max(0, Math.min(index, cards.length - 1))];
          if (!card) return;
          rail.scrollTo({
            left: card.offsetLeft - rail.offsetLeft,
            behavior: window.matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth",
          });
        };
        previous.addEventListener("click", () => showCard(currentIndex - 1));
        next.addEventListener("click", () => showCard(currentIndex + 1));
        rail.addEventListener("scroll", () => {
          window.cancelAnimationFrame(frame);
          frame = window.requestAnimationFrame(updateControls);
        }, { passive: true });
        controls.append(previous, progress, next);
        updateControls();
      }
      header.append(headingCopy, controls);
      group.append(header, rail);
      return group;
    }

    function toggleMix(item: GalleryItem) {
      const existing = selectedMix.findIndex((entry) => entry.variantId === item.variantId);
      if (existing >= 0) {
        selectedMix.splice(existing, 1);
        announcer.textContent = `${item.title} removed from the style mix.`;
      } else if (selectedMix.length < 3) {
        const role = selectedMix.length === 0 ? "base" : `influence ${selectedMix.length}`;
        selectedMix.push(item);
        announcer.textContent = `${item.title} added as ${role}. ${selectedMix.length === 1 ? "Choose an influence to enable this mix." : "The mix is ready to use."}`;
      }
      else {
        announcer.textContent = "The mix is full. Remove a style before adding another.";
      }
      renderMix();
      if (selectedMix.length === 3 && existing < 0) mixStatus.textContent = announcer.textContent;
    }

    function makeBase(item: GalleryItem) {
      const existing = selectedMix.findIndex((entry) => entry.variantId === item.variantId);
      if (existing <= 0) return;
      selectedMix.splice(existing, 1);
      selectedMix.unshift(item);
      announcer.textContent = `${item.title} is now the base style.`;
      renderMix();
    }

    function renderMix() {
      if (state.dataset.state !== "error") state.hidden = true;
      mixTray.hidden = selectedMix.length === 0;
      root.classList.toggle("has-gallery-mix", selectedMix.length > 0);
      mixCount.textContent = `${selectedMix.length}/3`;
      mixUse.disabled = selectedMix.length < 2;
      mixUse.textContent = selectedMix.length < 2 ? "Add an influence" : `Use ${selectedMix.length}-style mix`;
      mixStatus.textContent = selectedMix.length === 1 ? "Choose at least one influence to continue." : selectedMix.length >= 2 ? "Mix ready." : "";
      mixChips.replaceChildren(...selectedMix.map((item, index) => {
        const chip = element("div", "gallery-mix__chip");
        const copy = element("span", "gallery-mix__chip-copy");
        const role = element("strong");
        const detail = element("small");
        const actions = element("span", "gallery-mix__chip-actions");
        role.textContent = `${index === 0 ? "Base" : `Influence ${index}`}: ${item.title}`;
        detail.textContent = `${item.engine} · ${labelFor(item.motionTags[0] ?? item.family)}`;
        copy.append(role, detail);
        if (index > 0) {
          const base = element("button");
          base.type = "button";
          base.textContent = "Make base";
          base.setAttribute("aria-label", `Make ${item.title} the base style`);
          base.addEventListener("click", () => makeBase(item));
          actions.append(base);
        }
        const remove = element("button");
        remove.type = "button";
        remove.textContent = "Remove";
        remove.setAttribute("aria-label", `Remove ${item.title} from mix`);
        remove.addEventListener("click", () => toggleMix(item));
        actions.append(remove);
        chip.append(copy, actions);
        return chip;
      }));
      for (const button of grid.querySelectorAll<HTMLButtonElement>("[data-mix-variant]")) {
        const selectedIndex = selectedMix.findIndex((item) => item.variantId === button.dataset.mixVariant);
        const selected = selectedIndex >= 0;
        button.setAttribute("aria-pressed", String(selected));
        button.textContent = button.disabled
          ? "Mix unavailable"
          : selected
            ? selectedIndex === 0 ? "Remove base" : "Remove influence"
            : selectedMix.length === 0 ? "Set as base" : "Add as influence";
      }
    }

    mixClear.addEventListener("click", () => {
      selectedMix = [];
      announcer.textContent = "Style mix cleared.";
      mixStatus.textContent = "";
      renderMix();
    });
    mixUse.addEventListener("click", () => {
      if (selectedMix.length < 2) return;
      const mix = selectedMix.map((item) => item.variantId).join(",");
      const prompt = `Use ${selectedMix[0].title} as the base structure, influenced by ${selectedMix.slice(1).map((item) => item.title).join(" and ")}. Make the central idea literal and readable.`;
      const params = new URLSearchParams({ variant: selectedMix[0].variantId, mix, prompt });
      window.location.href = `/marketing?${params.toString()}#marketing-create-title`;
    });

    function attachLazyVideos() {
      const videos = [...grid.querySelectorAll<HTMLVideoElement>("video[data-src]")];
      if (!("IntersectionObserver" in window)) {
        for (const video of videos) {
          video.src = video.dataset.src ?? "";
          delete video.dataset.src;
        }
        return;
      }
      const observer = new IntersectionObserver((entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const video = entry.target as HTMLVideoElement;
          video.preload = "metadata";
          video.src = video.dataset.src ?? "";
          delete video.dataset.src;
          video.load();
          observer.unobserve(video);
        }
      }, { rootMargin: "320px 0px" });
      for (const video of videos) observer.observe(video);
    }

    function applyFilter(family: string) {
      if (!gallery) return;
      activeFamily = family;
      filterSelect.value = family;
      for (const button of filters.querySelectorAll<HTMLButtonElement>("button[data-gallery-family]")) {
        button.setAttribute("aria-pressed", String(button.dataset.galleryFamily === family));
      }
      let visible = 0;
      for (const group of grid.querySelectorAll<HTMLElement>(".gallery-group[data-family]")) {
        const show = family === "all" || group.dataset.family === family;
        group.hidden = !show;
        if (show) visible += Number(group.dataset.proofCount ?? 0);
      }
      resultCount.textContent = `${visible} ${visible === 1 ? "substantive demo" : "substantive demos"}${family === "all" ? " across proven capabilities" : ` in ${family}`}`;
    }

    async function loadGallery() {
      try {
        const response = await fetch(`${serviceOrigin}/studio/explore-gallery/representatives`, { headers: { accept: "application/json" } });
        const payload = await response.json();
        if (!response.ok) throw new Error(typeof payload.error === "string" ? payload.error : "Gallery request failed");
        gallery = payload.data as Gallery;
        count.textContent = `${gallery.provenCapabilityCount}/${gallery.totalCapabilityCount}`;
        optionCount.textContent = String(gallery.exactOptionCount);
        proofCount.textContent = String(gallery.proofCount);
        if (gallery.unproven.length) {
          coverage.hidden = false;
          coverageSummary.textContent = `${gallery.unproven.length} ${gallery.unproven.length === 1 ? "capability" : "capabilities"} unproven`;
          coverageNote.textContent = `Not counted as proven: ${gallery.unproven.map((item) => `${labelFor(item.recipeId)} — ${item.reason}`).join(" ")}`;
        }
        for (const family of gallery.families) {
          const button = element("button");
          button.type = "button";
          button.dataset.galleryFamily = family;
          button.setAttribute("aria-pressed", "false");
          button.textContent = family;
          button.addEventListener("click", () => applyFilter(family));
          filters.append(button);
          const option = element("option");
          option.value = family;
          option.textContent = family;
          filterSelect.append(option);
        }
        filterSelect.addEventListener("change", () => applyFilter(filterSelect.value));
        filters.querySelector<HTMLButtonElement>("[data-gallery-family='all']")?.addEventListener("click", () => applyFilter("all"));
        const familyOrder = ["Image model", "Internal video model", "ASCII", "Three.js", "Blender", "Motion graphics", "Product proof", "Guided app demo", "Narrated", "Podcast", "Lyric video"];
        const grouped = new Map<string, GalleryItem[]>();
        for (const item of gallery.items) {
          const current = grouped.get(item.recipeId) ?? [];
          current.push(item);
          grouped.set(item.recipeId, current);
        }
        const groups = [...grouped.values()].sort((a, b) => {
          const aIndex = familyOrder.indexOf(a[0].family);
          const bIndex = familyOrder.indexOf(b[0].family);
          return (aIndex < 0 ? 99 : aIndex) - (bIndex < 0 ? 99 : bIndex);
        });
        grid.replaceChildren(...groups.map(groupFor));
        state.hidden = true;
        grid.hidden = false;
        applyFilter(activeFamily);
        attachLazyVideos();
        renderMix();
      } catch (error) {
        count.textContent = "0";
        proofCount.textContent = "0";
        optionCount.textContent = "—";
        resultCount.textContent = "Gallery unavailable";
        state.dataset.state = "error";
        state.textContent = `${error instanceof Error ? error.message : String(error)} Start Reel Pipeline on port 4317, then reload this page.`;
      }
    }

    void loadGallery();
  }
</script>

<style is:global>
  .explore-gallery { padding: 0 0 80px; }
  .explore-gallery.has-gallery-mix { padding-bottom: 180px; }
  .gallery-summary { display: flex; min-width: 0; align-items: center; justify-content: space-between; gap: 20px; }
  .gallery-tally { min-width: 0; display: flex; align-items: baseline; gap: 9px; }
  .gallery-tally strong { font-size: 25px; line-height: 1; letter-spacing: -.03em; }
  .gallery-tally span { color: var(--muted); font-size: 12px; }
  .gallery-tally small { color: var(--quiet); font-size: 11px; }
  .gallery-tally small span { display: inline; margin: 0; color: inherit; font-size: inherit; }
  .gallery-coverage { min-width: 0; color: var(--muted); font-size: 11px; }
  .gallery-coverage summary { width: fit-content; margin-left: auto; color: var(--warning); cursor: pointer; font-weight: 720; }
  .gallery-coverage p { max-width: 74ch; margin: 8px 0 0; color: var(--muted); line-height: 1.5; text-align: right; }
  .gallery-controls { position: sticky; top: 0; z-index: 4; display: grid; gap: 10px; padding: 13px 0 12px; border-bottom: 1px solid var(--line); background: color-mix(in srgb, var(--canvas) 96%, transparent); backdrop-filter: blur(10px); }
  .gallery-filters { display: flex; flex-wrap: wrap; gap: 7px; overflow-x: auto; padding-bottom: 2px; scrollbar-width: thin; }
  .gallery-filters button { flex: none; min-height: 34px; padding: 6px 11px; border: 1px solid var(--line-strong); border-radius: 999px; background: transparent; color: var(--muted); font: inherit; font-size: 12px; font-weight: 720; cursor: pointer; }
