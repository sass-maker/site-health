---
import DashboardLayout from "../components/DashboardLayout.astro";
---

<DashboardLayout
  title="Performance"
  description="Is every public product fast enough?"
  active="performance"
  view="performance"
>
  <div slot="meta" class="page-head__meta">
    <button type="button" class="secondary-action" data-portfolio-refresh="psi">Run all PSI</button>
    <span class="portfolio-refresh-status" role="status" aria-live="polite" data-portfolio-refresh-status="psi"></span>
    <span class="snapshot-time" data-outcome-time>Reading performance evidence</span>
  </div>
  <section class="owner-section owner-section--directory" aria-label="Public product performance">
    <div class="loading-state" data-dashboard-slot="performance">Building performance guardrail…</div>
  </section>
</DashboardLayout>
