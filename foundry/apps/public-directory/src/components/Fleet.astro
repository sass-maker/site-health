---
import { CORE, ACTIVE_GROUPS, PAST_PROJECTS, PROJECT_COUNT } from '../data/projects';
import { LEARNINGS } from '../data/learnings';

const latestLearning = LEARNINGS[0];
---
<section class="section" id="products">
  <div class="section-head">
    <h2 class="section-title">Four projects in focus.</h2>
    <p class="section-lede">
      Each product keeps its own home, roadmap, changelog, and release boundary.
    </p>
  </div>

  <ol class="spotlight-list">
    {CORE.map((p) => (
      <li>
        <a href={p.href} class="spotlight-item">
          <span class="spotlight-copy">
            <strong>{p.name}</strong>
            <span>{p.desc}</span>
          </span>
          <span class="spotlight-host">{p.tag}</span>
          <span class="spotlight-arrow" aria-hidden="true">↗</span>
        </a>
      </li>
    ))}
  </ol>

  <aside class="learning-rail" aria-label="Latest learning">
    <a href={latestLearning.href}>
      <span class="eyebrow">Latest learning</span>
      <strong>{latestLearning.title}</strong>
      <span class="learning-rail-meta">
        <span>{latestLearning.readingTime}</span>
        <span aria-hidden="true">→</span>
      </span>
    </a>
  </aside>

  <div class="catalog">
    <div class="active-head">
      <div>
        <h2>The rest of the catalog</h2>
      </div>
      <p>{PROJECT_COUNT - CORE.length} quietly useful tools, research projects, and personal utilities.</p>
    </div>
    <div class="active-groups">
      {ACTIVE_GROUPS.map((group) => (
        <section class="active-group" aria-labelledby={`group-${group.id}`}>
          <h3 id={`group-${group.id}`}>{group.label}</h3>
          <ul class="active-grid">
            {group.products.map((p) => (
              <li>
                <a href={p.href} class="mini">
                  <span>
                    <strong class="mini-name">{p.name}</strong>
                    <span class="mini-desc">{p.desc}</span>
                  </span>
                  <span class="mini-arrow" aria-hidden="true">→</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </div>

  <div class="catalog" id="past-projects">
    <div class="active-head">
      <div>
        <p class="eyebrow">Public repository history</p>
        <h2>Past projects</h2>
      </div>
      <p>Preserved source and attribution without turning retired work into an active maintenance promise.</p>
    </div>
    <div class="active-groups">
      <section class="active-group" aria-labelledby="past-project-list">
        <h3 id="past-project-list">{PAST_PROJECTS.length} public repositories</h3>
        <ul class="active-grid">
          {PAST_PROJECTS.map((project) => (
            <li>
              <a href={project.repositoryUrl} class="mini" target="_blank" rel="noopener noreferrer">
                <span>
                  <strong class="mini-name">{project.name}</strong>
                  <span class="mini-desc">{project.desc}</span>
                </span>
                <span class="mini-arrow" aria-hidden="true">↗</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    </div>
  </div>
</section>
