{
  "_meta": {
    "purpose": "Single source of truth for fleet projects: tier + repo + deploy reality. Replaces the scattered split between agent-surfaces-registry.json (web GEO surfaces only), cloudflare.targets.json (partial deploy map), and project-tiers.md (focus marking). Reconciled against the live Cloudflare account 2026-07-18.",
    "updated": "2026-07-26",
    "fields": {
      "id": "stable project/surface id",
      "family": "top-level product family this belongs to",
      "tier": "focus | active | secondary | parked | out-of-fleet | non-product",
      "priority": "P1 | P2 | P3 current attention level; P1 is core, P2 is support/active, P3 is maintain or park",
      "repo": "child repo dir under fleet root (null if none)",
      "sourcePath": "optional source checkout path relative to fleet root when the repo is stored outside the active workspace",
      "_meta.absorbedCheckouts": "top-level historical checkout names preserved locally and their canonical catalog identities",
      "deployKind": "pages | worker | worker+pages | none | unknown",
      "cfProject": "Cloudflare Pages project name and/or Worker script name(s)",
      "cfPages": "optional exact Cloudflare Pages project names when cfProject also describes Worker surfaces",
      "deployTargets": "optional exact per-surface objects with id, kind, name, and sourcePath; required for mixed or multi-source deploys",
      "tursoDatabases": "optional exact Turso database names owned by this project",
      "domains": "live custom domains (empty = pages.dev only or undeployed)",
      "domainProbePaths": "optional per-domain HTTP path overrides for live health probes",
      "inRegistry": "present in agent-surfaces-registry.json",
      "status": "live | undeployed | orphan | deleted | unverified",
      "authModel": "required-user | required-service | public-personalized | public-persistent",
      "notes": "reconciliation flags / decisions",
      "name": "human display name",
      "attention": "my-work | toolbox | foundry | ignored",
      "lifecycle": "maintained | local-only | past | non-product",
      "repositoryVisibility": "public | private | unknown",
      "public": "sanitized public listing metadata; listing is maintained | past | hidden"
    },
