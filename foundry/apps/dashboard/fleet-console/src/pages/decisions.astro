---
import FounderLayout from "../components/FounderLayout.astro";
const groups = [
  { id: "open", label: "Open", detail: "Fresh decisions waiting for an owner response." },
  { id: "stale", label: "Stale", detail: "Questions whose evidence or decision window has aged." },
  { id: "resolved", label: "Resolved", detail: "Owner choices with a durable receipt." },
  { id: "rejected", label: "Rejected", detail: "Requests explicitly declined." },
  { id: "reversed", label: "Reversed", detail: "Prior choices superseded through an append-only correction." },
];
---

<FounderLayout title="Decisions" description="Every request for your judgment, with scope, consequence, and reversibility." active="decisions" view="decisions">
  {groups.map((group) => (
    <section class="owner-section" aria-labelledby={`${group.id}-title`}>
      <div class="section-head"><div><p class="eyebrow">Owner decision</p><h2 id={`${group.id}-title`}>{group.label}</h2><p>{group.detail}</p></div><span class="count" data-founder-count={group.id}>—</span></div>
      <div class="loading-state" data-founder-slot={group.id}>Loading {group.label.toLowerCase()} decisions…</div>
    </section>
  ))}
</FounderLayout>
