---
import FounderLayout from "../../components/FounderLayout.astro";
import { getFleetProjects } from "../../lib/fleet-data";

export function getStaticPaths() {
  return getFleetProjects().map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
---

<FounderLayout
  title={project.title}
  description="Current objective, verified outcomes, owner decisions, and mission history for this product."
  active="projects"
  view="project"
  projectId={project.slug}
>
  <section class="owner-section" aria-labelledby="project-control-title">
    <div class="section-head">
      <div>
        <p class="eyebrow">Product control loop</p>
        <h2 id="project-control-title">Current state</h2>
        <p>Canonical identity stays in the Fleet registry. Foundry shows only owner-relevant projections.</p>
      </div>
    </div>
    <div class="loading-state" data-founder-slot="project-detail">Loading project evidence…</div>
  </section>
</FounderLayout>
