---
import FounderLayout from "../components/FounderLayout.astro";
---

<FounderLayout
  title="Performance"
  description="Is every public product fast enough?"
  active="performance"
  view="performance"
>
  <div slot="meta" class="page-head__meta">
    <span class="snapshot-time" data-outcome-time>Reading performance evidence</span>
  </div>
  <section class="owner-section owner-section--directory" aria-labelledby="performance-guardrail-title">
    <div class="section-head">
      <div>
        <h2 id="performance-guardrail-title">Public product guardrail</h2>
        <p>Fast enough means PSI 90 or higher and LCP 2.5 seconds or lower.</p>
      </div>
      <span class="count" data-founder-count="performance">—</span>
    </div>
    <div class="loading-state" data-founder-slot="performance">Building performance guardrail…</div>
  </section>
</FounderLayout>
