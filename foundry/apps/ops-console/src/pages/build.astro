---
import FleetNav from "../components/FleetNav.astro";
import { getFleetDevlog, getFleetProjects } from "../lib/fleet-data";

const projects = getFleetProjects();
const devlogProjects = getFleetDevlog(4);
const commits = devlogProjects
  .flatMap((project) => project.commits)
  .sort((left, right) => Date.parse(right.committedAt) - Date.parse(left.committedAt));
const latestCommitAt = commits[0]?.committedAt ?? null;
const commitsToday = commits.filter((commit) => Date.now() - Date.parse(commit.committedAt) < 24 * 60 * 60 * 1000).length;
const localChanges = projects.filter((project) => project.dirtyCount > 0).length;
const focusProjects = projects.filter((project) => project.tier === "focus");
const formatDate = (value: string | null) => value
  ? new Intl.DateTimeFormat("en", { dateStyle: "medium", timeStyle: "short", timeZone: "Asia/Kolkata" }).format(new Date(value))
  : "No recent update";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Changes · Fleet Ops</title>
    <meta name="description" content="Recent product changes across the Fleet repositories." />
  </head>
  <body>
    <main class="shell">
      <FleetNav active="build" />
      <header class="topbar"><div><p class="eyebrow">Fleet / Changes</p><h1>What shipped</h1></div></header>

      <section class="summary" aria-label="Change summary">
        <div><span>Repositories</span><strong>{devlogProjects.length}</strong><small>with recent commits</small></div>
        <div><span>Last 24 hours</span><strong>{commitsToday}</strong><small>recorded commits</small></div>
        <div><span>Focus products</span><strong>{focusProjects.length}</strong><small>current personal bets</small></div>
        <div><span>Local changes</span><strong>{localChanges}</strong><small>checkouts not clean</small></div>
      </section>

      <section class="band">
        <div class="section-head">
          <div><p class="eyebrow">Product changelog</p><h2>Recent repository activity</h2></div>
          <span>Latest {formatDate(latestCommitAt)}</span>
        </div>
        <div class="devlog-list">
          {devlogProjects.map((project) => (
            <article class="project-log">
              <header>
                <div><h3>{project.projectTitle}</h3><a href={`/projects/${project.projectSlug}`}>Project overview</a></div>
                {project.repoUrl && <a href={project.repoUrl}>Repository</a>}
              </header>
              <ol>
                {project.commits.map((commit) => (
                  <li>
                    <code>{commit.shortHash}</code>
                    <strong>{commit.subject}</strong>
                    <time datetime={commit.committedAt}>{formatDate(commit.committedAt)}</time>
                  </li>
                ))}
              </ol>
            </article>
          ))}
        </div>
      </section>
    </main>
  </body>
</html>

<style>
  :root{color-scheme:dark;--bg:#090b0c;--surface:#101416;--line:#2b302d;--text:#f3f6f4;--muted:#a6aea9;--mint:#79dcc8}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font-family:Inter,ui-sans-serif,system-ui,sans-serif}.shell{width:min(1240px,100%);margin:auto;padding:24px}.topbar{min-height:150px;display:flex;align-items:flex-end;border-bottom:1px solid var(--line);padding-bottom:24px}.eyebrow{margin:0 0 8px;color:var(--mint);font-size:12px;font-weight:800;text-transform:uppercase}h1,h2,h3,p{margin-top:0}h1{margin-bottom:0;font-size:52px;line-height:1}h2{margin-bottom:0;font-size:28px}.summary{display:grid;grid-template-columns:repeat(4,1fr);border-bottom:1px solid var(--line)}.summary div{min-height:145px;padding:24px;border-right:1px solid var(--line);display:grid;align-content:center}.summary div:last-child{border-right:0}.summary span,.summary small,.section-head>span{color:var(--muted)}.summary strong{font-size:40px}.band{padding:44px 0;border-bottom:1px solid var(--line)}.section-head{display:flex;align-items:end;justify-content:space-between;gap:20px;margin-bottom:24px}.devlog-list{border-top:1px solid var(--line)}.project-log{display:grid;grid-template-columns:240px 1fr;gap:28px;padding:24px 0;border-bottom:1px solid var(--line)}.project-log>header{display:flex;align-items:flex-start;justify-content:space-between;gap:12px}.project-log h3{margin-bottom:4px;font-size:19px}.project-log a{color:var(--mint);font-size:12px}.project-log ol{margin:0;padding:0;list-style:none}.project-log li{display:grid;grid-template-columns:72px minmax(0,1fr) 180px;gap:14px;align-items:center;min-height:56px;padding:10px 12px;border:1px solid var(--line);border-bottom:0;background:var(--surface)}.project-log li:last-child{border-bottom:1px solid var(--line)}.project-log code{color:var(--mint);font-size:12px}.project-log li strong{font-size:14px;overflow-wrap:anywhere}.project-log time{color:var(--muted);font-size:12px;text-align:right}@media(max-width:760px){.shell{padding:14px}.topbar,.section-head{display:grid}.topbar{min-height:170px}h1{font-size:40px}.summary{grid-template-columns:1fr 1fr}.summary div{min-width:0;min-height:115px;padding:16px}.summary div:nth-child(2){border-right:0}.project-log{grid-template-columns:1fr;gap:16px}.project-log li{grid-template-columns:64px minmax(0,1fr)}.project-log time{grid-column:2;text-align:left}}
</style>
