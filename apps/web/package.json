{
  "name": "site-health-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build && node scripts/build-worker.mjs",
    "preview": "astro preview --host 127.0.0.1 --allowed-hosts fleet.sassmaker.com",
    "check": "pnpm run build"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "astro": "^7.2.0",
    "typescript": "^5.8.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ],
    "overrides": {
      "svgo": "^4.0.2",
      "fast-uri": "^3.1.5",
      "js-yaml": "^4.3.1",
      "sharp": "^0.35.0"
    }
  }
}
