# Ignore every child project by default. Each project keeps its own git repo.
/*

# Track only Dashboard repository files.
!/.gitignore
!/README.md
!/AGENTS.md
!/CLAUDE.md
!/PROJECT_STATUS.md
!/package.json
!/foundry/
!/.github/

# Local/system noise at the Fleet root.
.DS_Store
__pycache__/
*.pyc
.env*
.omx/
.wrangler/
.claude/
.husky/

# Infisical project link (workspaceId pointer — keep local)
.infisical.json

# Local Dashboard state.
foundry/apps/dashboard/backend/*.sqlite
foundry/apps/dashboard/backend/*.sqlite-*
