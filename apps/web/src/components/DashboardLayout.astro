---
import DashboardNav from "./DashboardNav.astro";
import "../styles/dashboard.css";

interface Props {
  title: string;
  description: string;
  active: "domains" | "search" | "ai-awareness" | "performance" | "projects";
  eyebrow?: string;
  view?: "domains" | "search" | "ai-awareness" | "performance" | "projects" | "project";
  projectId?: string;
  showProjectScope?: boolean;
  loadDashboardEvidence?: boolean;
}

const { title, description, active, eyebrow = "Site Health evidence", view, projectId, showProjectScope = true, loadDashboardEvidence = true } = Astro.props;
const filterable = showProjectScope && !["project", "domains", "search", "ai-awareness", "performance"].includes(view ?? "");
const directoryView = ["domains", "search", "ai-awareness", "performance", "projects"].includes(view ?? "");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="dashboard-api-base" content="/api/dashboard" />
    <title>{title} · Site Health</title>
    <meta name="description" content={description} />
  </head>
  <body data-dashboard-view={view} data-project-id={projectId} data-dashboard-evidence={String(loadDashboardEvidence)}>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="shell" data-sidebar-shell>
      <DashboardNav active={active} />
      <button
        class="sidebar-backdrop"
        type="button"
        tabindex="-1"
        aria-label="Close navigation"
        data-sidebar-backdrop
      ></button>
      <main id="main" class:list={["main-shell", { "main-shell--directory": directoryView }]}>
        <button
          class="sidebar-mobile-toggle"
          type="button"
          aria-label="Menu"
          aria-controls="dashboard-sidebar"
          aria-expanded="false"
          data-sidebar-open
        >
          <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
          <span>Menu</span>
        </button>
        <header class:list={["page-head", { "page-head--compact": directoryView }]}>
          <div>
            <p class="eyebrow">{eyebrow}</p>
            <h1>{title}</h1>
            <p class="lede">{description}</p>
          </div>
          <slot name="meta" />
        </header>
        <div class="global-status" data-dashboard-global-status aria-live="assertive"></div>
        {filterable && (
          <section class:list={["project-scope", { "project-scope--compact": directoryView }]} aria-label="Project scope" data-project-scope>
            <div>
              <span>Project scope</span>
              <strong data-project-scope-label>All projects</strong>
            </div>
            <label>
              <span class="sr-only">Filter this page by project</span>
              <select id="project-scope-select" name="project" data-project-scope-select>
                <option value="">All projects</option>
              </select>
            </label>
          </section>
        )}
        <slot />
      </main>
    </div>
    <script>
      import "../scripts/dashboard-client";
    </script>
    <script
      is:inline
      src="https://sassmaker.com/project-strip.js"
      data-project="site-health"
      defer
    ></script>
    <script
      is:inline
      src="https://sassmaker.com/ai-chat-footer.js"
      data-name="Site Health"
      defer
    ></script>
  </body>
</html>
