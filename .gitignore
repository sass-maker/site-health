# Ignore every child project by default. Each project keeps its own git repo.
/*

# Track only Fleet workspace control files.
!/.gitignore
!/README.md
!/AGENTS.md
!/CLAUDE.md
!/LANDING_STANDARD.md
!/fleet-ops/
!/assets/
!/docs/
!/scripts/
!/.agents/

# Local/system noise at the Fleet root.
.DS_Store
.env*
.omx/
.wrangler/
.claude/
.husky/
