    <span class="brand-mark sm" aria-hidden="true">S</span>
    <span>A product directory by <a href={OWNER_URL} target="_blank" rel="noopener noreferrer">Sarthak Agrawal</a></span>
  </div>
  <div class="footer-links">
    <a href="/privacy">Privacy</a>
    <a href="/terms">Terms</a>
    <a href={PACKAGE_URL} target="_blank" rel="noopener noreferrer">Package</a>
    <a href={PUBLIC_REPOSITORY_URL} target="_blank" rel="noopener noreferrer">Source</a>
  </div>
  <p class="footer-tagline">Products keep their own domains and release boundaries.</p>
</footer>
