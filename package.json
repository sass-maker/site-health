{
  "name": "dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "Private portfolio dashboard and its backend",
  "scripts": {
    "dev": "pnpm --dir foundry/apps/dashboard/web dev",
    "backend": "node foundry/apps/dashboard/backend/scripts/server.mjs serve",
    "build": "pnpm --dir foundry/apps/dashboard/web build",
    "test:backend": "node --disable-warning=ExperimentalWarning --test foundry/apps/dashboard/backend/test/*.test.mjs",
    "test:ai": "pnpm --dir foundry/apps/dashboard/backend/packages/ai-visibility check",
    "test": "pnpm run test:backend && pnpm run test:ai",
    "check": "pnpm run build && pnpm run test"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.2"
}
