---
import FounderLayout from "../components/FounderLayout.astro";
---

<FounderLayout
  title="Performance"
  description="Public product speed against one explicit guardrail: PSI at least 90 and LCP at most 2.5 seconds."
  active="performance"
  view="performance"
>
  <div slot="meta" class="page-head__meta">
    <span class="snapshot-time" data-connections-time>Reading performance evidence</span>
  </div>

  <section class="owner-section owner-section--directory" aria-labelledby="performance-title">
    <div class="section-head">
      <div>
        <h2 id="performance-title">Public product speed</h2>
        <p>Both measures must pass. If either is absent, the product stays not measured.</p>
      </div>
      <span class="count" data-founder-count="performance">—</span>
    </div>
    <div class="loading-state" data-founder-slot="performance">Building the performance directory…</div>
  </section>
</FounderLayout>
