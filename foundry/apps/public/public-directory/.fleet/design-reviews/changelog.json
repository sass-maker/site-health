{
  "$schema": "fleet.design-review.v1",
  "version": 1,
  "project": "public-directory",
  "target": "SaaS Maker changelog",
  "mode": "preserve",
  "register": "brand",
  "context": {
    "product": "PRODUCT.md",
    "design": "DESIGN.md"
  },
  "direction": {
    "references": [],
    "probes": [],
    "selected": "existing-design",
    "approval": "not-required",
    "before": ".fleet/evidence/before-changelog-reference-1440.png"
  },
  "evidence": {
    "screenshots": [
      { "width": 390, "path": ".fleet/evidence/overhaul/after-changelog-390.png" },
      { "width": 768, "path": ".fleet/evidence/overhaul/after-changelog-768.png" },
      { "width": 1440, "path": ".fleet/evidence/overhaul/after-changelog-1440.png" }
    ],
    "projectCheck": { "command": "npm run check", "status": "pass" },
    "critique": { "score": 35, "maximum": 40 },
    "audit": { "score": 19, "maximum": 20 },
    "unresolved": { "p0": 0, "p1": 0 },
    "detector": { "posture": "advisory", "findings": [] },
    "browserReview": {
      "tool": "Playwright",
      "viewports": [390, 768, 1440],
      "horizontalOverflow": false,
      "consoleErrors": 0,
      "note": "The changelog was inspected at all required widths after the 768px hero reflow fix. It has one H1, four semantic dated entries, no horizontal overflow, no duplicate IDs, touch-safe links, no console errors, and no failed page or asset requests."
    }
  },
  "ownerFeedback": {
    "decision": "delegated",
    "note": "Owner explicitly delegated agents to build first-party changelogs across all projects."
  }
}
