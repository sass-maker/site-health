{
  "name": "site-health-web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build && node scripts/build-worker.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "check": "pnpm run build",
    "check:app-store": "tsc --project tsconfig.app-store.json"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "astro": "^7.2.0",
    "typescript": "^5.8.3",
    "@astrojs/react": "7.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ],
    "overrides": {
      "svgo": "^4.0.2",
      "fast-uri": "^3.1.5",
      "js-yaml": "^4.3.1",
      "sharp": "^0.35.0"
    }
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/node": "26.6.5"
  }
}
