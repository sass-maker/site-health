---
import FounderLayout from "../components/FounderLayout.astro";
---

<FounderLayout
  title="Product analytics"
  description="How many people visited, signed up, activated, and returned across every maintained Fleet product?"
  active="product-analytics"
  view="product-analytics"
>
  <div slot="meta" class="page-head__meta">
    <span class="state none" data-user-metrics-state>Reading user metrics</span>
    <span class="measurement-boundary-note" data-user-metrics-boundary>PostHog Insights and D1 aggregate evidence</span>
    <span class="snapshot-time" data-outcome-time>Reading provider evidence</span>
  </div>
  <section class="owner-section owner-section--directory" aria-labelledby="product-analytics-title">
    <div class="section-head">
      <div>
        <h2 id="product-analytics-title">Portfolio user metrics</h2>
        <p>Visitors, identified users, accounts, activation, retention, and core actions per product. Missing metrics are explicit — never inferred as zero.</p>
      </div>
      <span class="count" data-founder-count="product-analytics">—</span>
    </div>
    <div class="loading-state" data-founder-slot="product-analytics">Building product analytics view…</div>
  </section>
</FounderLayout>
