---
import FounderLayout from "../components/FounderLayout.astro";
---

<FounderLayout
  title="Marketing"
  description="What marketing produced and what is worth doing next."
  active="market"
  view="marketing"
>
  <section class="owner-section" aria-labelledby="marketing-recommendations-title">
    <div class="section-head">
      <div>
        <h2 id="marketing-recommendations-title">Worth doing next</h2>
      </div>
      <span class="count" data-founder-count="marketing-recommendations">—</span>
    </div>
    <div class="loading-state" data-founder-slot="marketing-recommendations">Reading recommendations…</div>
  </section>

  <section class="owner-section" aria-labelledby="marketing-outcomes-title">
    <div class="section-head">
      <div>
        <h2 id="marketing-outcomes-title">Published work and outcomes</h2>
      </div>
      <span class="count" data-founder-count="marketing-outcomes">—</span>
    </div>
    <div class="loading-state" data-founder-slot="marketing-outcomes">Reading publishing receipts…</div>
  </section>
</FounderLayout>
