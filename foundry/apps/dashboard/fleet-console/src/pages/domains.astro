---
import FounderLayout from "../components/FounderLayout.astro";
---

<FounderLayout
  title="Domains"
  description="Is every owned domain becoming more authoritative?"
  active="domains"
  view="domains"
>
  <div slot="meta" class="page-head__meta">
    <span class="snapshot-time" data-outcome-time>Reading domain evidence</span>
  </div>
  <section class="owner-section owner-section--directory" aria-labelledby="domain-directory-title">
    <div class="section-head">
      <div>
        <h2 id="domain-directory-title">Domain strength</h2>
        <p>One row per registrable domain, even when several products share it.</p>
      </div>
      <span class="count" data-founder-count="domains">—</span>
    </div>
    <div class="loading-state" data-founder-slot="domains">Building domain directory…</div>
  </section>
</FounderLayout>
