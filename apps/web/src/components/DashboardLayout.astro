---
import { themeBootstrap } from "../scripts/theme.mjs";
import { DashboardHeader, CohortControl } from "./DashboardControls";
import SiteHealthShell from "./SiteHealthShell";
import DashboardRuntime from "./DashboardRuntime";
import "../styles/shared-ui.css";
import "../styles/dashboard.css";

interface Props {
  title: string;
  description: string;
  active: "domains" | "search" | "ai-awareness" | "performance" | "projects" | "readiness" | "ui-library";
  eyebrow?: string;
  view?: "domains" | "search" | "ai-awareness" | "performance" | "projects" | "project" | "app-store" | "readiness" | "ui-library";
  projectId?: string;
  showProjectScope?: boolean;
  loadDashboardEvidence?: boolean;
}

const { title, description, active, eyebrow = "Site Health evidence", view, projectId, showProjectScope = true, loadDashboardEvidence = true } = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="base" data-mode="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline set:html={themeBootstrap} />
    <meta name="color-scheme" content="light dark" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="dashboard-api-base" content="/api/dashboard" />
    <title>{title} · Site Health</title>
    <meta name="description" content={description} />
  </head>
  <body data-dashboard-view={view} data-project-id={projectId} data-dashboard-evidence={String(loadDashboardEvidence)}>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHealthShell client:load active={active}>
      <div id="main" tabindex="-1">
        {!["readiness", "projects", "ui-library"].includes(view ?? "") && <><DashboardHeader title={title} description={description}>{view==="project"&&<slot name="meta"/>}</DashboardHeader>{view!=="project"&&<div class="page-evidence-controls"><slot name="meta" /></div>}</>}
        <div class="global-status" data-dashboard-global-status aria-live="assertive"></div>
        {["domains", "search", "ai-awareness", "performance"].includes(view ?? "") && <CohortControl />}
        <slot />

      </div>
    </SiteHealthShell>
    <DashboardRuntime client:load />
  </body>
</html>
