---
import '../styles/global.css';
import RunDashboard from '../components/RunDashboard.tsx';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>psi-swarm · perf swarms with p99</title>
    <meta name="description" content="Run Lighthouse N times across realistic device/network presets. See p50/p75/p90/p99 of your Web Vitals, not one noisy number." />
    <link rel="canonical" href="https://performance.sassmaker.com/" />
    <meta property="og:title" content="psi-swarm — Distributional Lighthouse Performance Tracker" />
    <meta property="og:description" content="Run Lighthouse many times across realistic device presets. Get p50/p75/p90/p99 Web Vitals instead of one noisy point." />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://performance.sassmaker.com/" />
    <meta property="og:site_name" content="psi-swarm" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="psi-swarm — Distributional Lighthouse Performance Tracker" />
    <meta name="twitter:description" content="Run Lighthouse many times across realistic device presets. Get p50/p75/p90/p99 Web Vitals." />
    <script type="application/ld+json" set:html={JSON.stringify({"@context":"https://schema.org","@graph":[{"@type":"Organization","@id":"https://sassmaker.com/#org","name":"SaaS Maker (Foundry)","url":"https://sassmaker.com"},{"@type":"WebSite","@id":"https://performance.sassmaker.com/#website","name":"psi-swarm","url":"https://performance.sassmaker.com","description":"Distributional Lighthouse performance tracker.","publisher":{"@id":"https://sassmaker.com/#org"}}]})} />
  </head>
  <body class="min-h-screen">
    <main class="max-w-5xl mx-auto px-6 py-10">
      <header class="mb-10 flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
        <div class="min-w-0">
          <h1 class="text-3xl font-bold tracking-tight">
            <span class="text-[var(--color-cyan)]">psi</span>-swarm
          </h1>
          <p class="text-[var(--color-dim)] mt-1 text-sm">
            Lighthouse, run many times across realistic presets. The shape of your perf, not one noisy point.
          </p>
        </div>
        <nav class="flex w-full flex-wrap items-center gap-x-5 gap-y-1 lg:w-auto lg:shrink-0 lg:flex-nowrap lg:justify-end" aria-label="Primary">
          <a href="./projects/" class="inline-flex min-h-11 items-center text-sm text-[var(--color-dim)] hover:text-[var(--color-text)] transition">
            projects
          </a>
          <a href="./compare/" class="inline-flex min-h-11 items-center text-sm text-[var(--color-dim)] hover:text-[var(--color-text)] transition">
            compare
          </a>
          <a href="./watchlist/" class="inline-flex min-h-11 items-center text-sm text-[var(--color-dim)] hover:text-[var(--color-text)] transition">
            watchlist
          </a>
          <a href="./gallery/" class="inline-flex min-h-11 items-center text-sm text-[var(--color-dim)] hover:text-[var(--color-text)] transition">
            gallery
          </a>
          <a href="/changelog" class="inline-flex min-h-11 items-center text-sm text-[var(--color-dim)] hover:text-[var(--color-text)] transition">
            changelog
          </a>
        </nav>
      </header>
      <RunDashboard client:load />
    </main>
  </body>
</html>
