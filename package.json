{
  "name": "fleet-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Canonical shared infrastructure workspace for the fleet",
  "scripts": {
    "check:components": "node foundry/ops/scripts/check-component-roots.mjs",
    "check:components:native": "node foundry/ops/scripts/run-component-checks.mjs",
    "check:actions": "node foundry/ops/scripts/check-github-actions-policy.mjs",
    "check:independence": "node foundry/ops/scripts/check-independent-product-boundaries.mjs",
    "check:design-workflow": "node foundry/ops/scripts/design-workflow.mjs self-check",
    "design:review": "node foundry/ops/scripts/design-workflow.mjs check",
    "generate:public": "node foundry/ops/scripts/generate-public-products.mjs",
    "generate:public-workflows": "node foundry/ops/scripts/sync-public-workflows-manifest.mjs",
    "check:public-workflows": "node foundry/ops/scripts/sync-public-workflows-manifest.mjs --check",
    "generate:projects": "node foundry/ops/scripts/generate-project-surfaces.mjs",
    "check:projects": "node foundry/ops/scripts/generate-project-surfaces.mjs --check",
    "generate:openspec-inventory": "node foundry/ops/scripts/generate-openspec-inventory.mjs",
    "check:public": "node foundry/ops/scripts/generate-public-products.mjs --check && node foundry/ops/scripts/sync-public-workflows-manifest.mjs --check && npm --prefix foundry/apps/public-directory run check",
    "check:registry": "node foundry/ops/scripts/generate-project-surfaces.mjs --check && node foundry/ops/scripts/validate-automation-registry.mjs && node foundry/ops/scripts/validate-marketing-program.mjs && node foundry/ops/scripts/check-retired-marketing-boundaries.mjs && node foundry/ops/scripts/check-independent-product-boundaries.mjs",
    "test:fleet": "npm run check:components && npm run check:actions && node --test foundry/ops/test/*.test.mjs"
  },
  "engines": {
    "node": ">=22"
  }
}
