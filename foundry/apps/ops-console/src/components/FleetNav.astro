---
import "../styles/founder.css";

interface Props {
  active: "home" | "projects" | "market" | "decisions" | "activity" | "overview" | "build";
}

const { active } = Astro.props;
const resolved = active === "overview" ? "home" : active;
const links = [
  { id: "home", href: "/", label: "Home" },
  { id: "projects", href: "/projects", label: "Projects" },
  { id: "market", href: "/marketing", label: "Marketing" },
  { id: "decisions", href: "/decisions", label: "Decisions" },
  { id: "activity", href: "/activity", label: "Activity" },
];
---

<header class="fleet-nav">
  <a class="brand" href="/">
    <span class="brand-mark" aria-hidden="true">F</span>
    <span><strong>Foundry</strong><small>Owner control</small></span>
  </a>
  <nav aria-label="Foundry">
    {links.map((link) => (
      <a aria-current={resolved === link.id ? "page" : undefined} class:list={{ active: resolved === link.id }} href={link.href}>
        {link.label}
      </a>
    ))}
  </nav>
  <span class="connection" data-founder-connection role="status" aria-live="polite">
    <i aria-hidden="true"></i>
    <span data-founder-connection-label>Connecting</span>
  </span>
</header>

<script>
  const indicator = document.querySelector<HTMLElement>("[data-founder-connection]");
  const label = document.querySelector<HTMLElement>("[data-founder-connection-label]");
  fetch("/api/founder/health", { headers: { accept: "application/json" } })
    .then((response) => {
      if (!response.ok) throw new Error("offline");
      indicator?.classList.add("online");
      if (label) label.textContent = "Live evidence";
    })
    .catch(() => {
      indicator?.classList.add("offline");
      if (label) label.textContent = "Offline";
    });
</script>
