---
import FounderLayout from "../../components/FounderLayout.astro";
import MarketingExploreGallery from "../../components/MarketingExploreGallery.astro";
---

<FounderLayout
  title="Explore video styles"
  description="Compare real video outputs before choosing a production preset."
  active="market"
  view="marketing"
>
  <div slot="meta" class="page-head__meta">
    <a class="gallery-back" href="/marketing">Back to Marketing</a>
  </div>
  <MarketingExploreGallery />
</FounderLayout>

<style>
  .gallery-back {
    color: var(--muted);
    font-size: 13px;
    font-weight: 720;
    text-decoration: none;
  }
  .gallery-back:hover { color: var(--accent); }
  .gallery-back:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }
</style>
