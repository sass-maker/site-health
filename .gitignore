# Ignore every child project by default. Each project keeps its own git repo.
/*

# Track only Fleet workspace control files.
!/.gitignore
!/README.md
!/AGENTS.md
!/CLAUDE.md
!/LANDING_STANDARD.md
!/fleet-ops/
!/assets/
!/.github/
!/openspec/
!/.openspec-store/
!/.codex/

# Local/system noise at the Fleet root.
.DS_Store
.env*
.omx/
.wrangler/
.claude/
.husky/

# Infisical project link (workspaceId pointer — keep local)
.infisical.json

# Devin fleet-run outputs (logs, prompts, markers)
fleet-ops/.devin-runs/

# Grok fan-out worktrees
fleet-ops/.grok-wt/
