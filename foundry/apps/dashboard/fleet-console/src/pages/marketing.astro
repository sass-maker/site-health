---
import FounderLayout from "../components/FounderLayout.astro";
---

<FounderLayout
  title="Marketing"
  description="Positioning, publication proof, and open recommendations for every maintained product."
  active="marketing"
  view="marketing"
>
  <div slot="meta" class="page-head__meta">
    <span class="snapshot-time" data-marketing-time>Reading portfolio coverage</span>
  </div>

  <section class="owner-section owner-section--directory" aria-labelledby="marketing-coverage-title">
    <div class="section-head">
      <div>
        <h2 id="marketing-coverage-title">Maintained products</h2>
        <p>Every maintained product appears, including products with no publication receipt.</p>
      </div>
      <span class="count" data-founder-count="marketing-coverage">—</span>
    </div>
    <div class="loading-state" data-founder-slot="marketing-coverage">Building the marketing directory…</div>
  </section>

  <section class="owner-section" aria-labelledby="marketing-recommendations-title">
    <div class="section-head">
      <div>
        <h2 id="marketing-recommendations-title">Worth doing next</h2>
        <p>Open, evidence-linked recommendations only.</p>
      </div>
      <span class="count" data-founder-count="marketing-recommendations">—</span>
    </div>
    <div class="loading-state" data-founder-slot="marketing-recommendations">Reading recommendations…</div>
  </section>
</FounderLayout>
