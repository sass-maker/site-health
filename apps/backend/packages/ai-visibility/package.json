{
  "name": "@site-health/ai-visibility",
  "version": "0.1.0",
  "private": true,
  "description": "Internal Site Health engine for AI mention, citation, recommendation, and visibility analysis.",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
