---
import FounderLayout from "../components/FounderLayout.astro";
import MarketingMaker from "../components/MarketingMaker.astro";
---

<FounderLayout
  title="Marketing"
  description="Projects and the posts created for them."
  active="market"
  view="marketing"
>
  <div slot="meta" class="page-head__meta">
    <span class="snapshot-time" data-outcome-time>Reading posts</span>
  </div>
  <MarketingMaker />
  <section class="owner-section owner-section--directory" aria-labelledby="marketing-projects-title">
    <div class="section-head">
      <div>
        <h2 id="marketing-projects-title">Projects and posts</h2>
        <p>Published and recorded posts, grouped by project.</p>
      </div>
      <span class="count" data-founder-count="marketing-coverage">—</span>
    </div>
    <div class="loading-state" data-founder-slot="marketing-coverage">Loading projects and posts…</div>
  </section>
</FounderLayout>
