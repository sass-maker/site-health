{
  "name": "site-health",
  "version": "0.1.0",
  "private": true,
  "description": "Private portfolio health dashboard and its backend",
  "scripts": {
    "dev": "pnpm --dir apps/web dev",
    "dashboard": "node scripts/start-owner.mjs",
    "backend": "node apps/backend/scripts/server.mjs serve",
    "clarity": "node apps/backend/scripts/clarity-collect.mjs",
    "clarity:refresh": "node apps/backend/scripts/clarity-collect.mjs fetch-all --days 3",
    "clarity:table": "node apps/backend/scripts/clarity-collect.mjs status-all --format markdown",
    "clarity:schedule": "node scripts/clarity-schedule.mjs",
    "docs:projects": "node scripts/generate-project-dossiers.mjs",
    "docs:projects:refresh": "node scripts/generate-project-dossiers.mjs --refresh --refresh-github",
    "docs:projects:refresh-local": "node scripts/generate-project-dossiers.mjs --refresh",
    "docs:projects:refresh-history": "node scripts/generate-project-dossiers.mjs --refresh-history",
    "docs:projects:check": "node scripts/generate-project-dossiers.mjs --check",
    "prepare:ci-catalog": "node scripts/prepare-ci-catalog.mjs",
    "docs:purpose-contracts": "node scripts/generate-purpose-contract-report.mjs",
    "docs:purpose-contracts:check": "node scripts/generate-purpose-contract-report.mjs --check",
    "build": "pnpm --dir apps/web build",
    "test:backend": "node --disable-warning=ExperimentalWarning --test apps/backend/test/*.test.mjs",
    "test:usage": "node --test apps/web/test/*.test.mjs",
    "test:owner": "node --test scripts/test/*.test.mjs",
    "test:owner:native": "node scripts/test-owner-native.mjs",
    "test:backend:ci": "node scripts/test-backend-ci.mjs",
    "test:ai": "pnpm --dir apps/backend/packages/ai-visibility check",
    "test": "pnpm run test:backend && pnpm run test:app-store:web && pnpm --dir apps/web check:app-store && pnpm run test:usage && pnpm run test:owner && pnpm run test:ai && pnpm run test:readiness",
    "check": "pnpm run docs:projects:check && pnpm run build && pnpm run test",
    "check:ci": "pnpm run prepare:ci-catalog && pnpm run build && pnpm run test:backend:ci && pnpm run test:app-store:web && pnpm --dir apps/web check:app-store && pnpm run test:usage && pnpm run test:owner && pnpm run test:ai && pnpm run test:readiness",
    "brand": "node apps/backend/scripts/brand-evidence.mjs",
    "owner:service": "node scripts/owner-service.mjs",
    "test:app-store": "node --disable-warning=ExperimentalWarning --test apps/web/test/app-store/*.test.ts apps/backend/test/app-store*.test.mjs",
    "test:app-store:web": "node --disable-warning=ExperimentalWarning --test apps/web/test/app-store/*.test.ts",
    "test:readiness": "pnpm --dir apps/web test:readiness && pnpm --dir apps/web check:readiness"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "yaml": "^2.9.0"
  },
  "packageManager": "pnpm@10.33.2",
  "dependencies": {
    "@saas-maker/collect": "file:vendor/saas-maker-collect-0.3.2.tgz",
    "ai": "6.0.168",
    "@ai-sdk/openai-compatible": "2.0.41"
  },
  "pnpm": {
    "overrides": {
      "@ai-sdk/provider-utils@4.0.23": "4.0.33"
    }
  }
}
