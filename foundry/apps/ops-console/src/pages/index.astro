---
import FounderLayout from "../components/FounderLayout.astro";
---

<FounderLayout
  title="Your portfolio, in one honest view."
  description="Decisions, accepted work, verified outcomes, and the next useful move—without infrastructure noise."
  active="home"
  view="home"
>
  <span slot="meta" class="snapshot-time" data-snapshot-time>Waiting for local evidence</span>

  <section class="owner-section" aria-labelledby="needs-me-title">
    <div class="section-head"><div><p class="eyebrow">Decide</p><h2 id="needs-me-title">Needs me</h2><p>Only bounded choices that cannot proceed without you.</p></div><span class="count" data-founder-count="needs-me">—</span></div>
    <div class="loading-state" data-founder-slot="needs-me">Loading owner decisions…</div>
  </section>
  <section class="owner-section" aria-labelledby="working-title">
    <div class="section-head"><div><p class="eyebrow">In motion</p><h2 id="working-title">Working now</h2><p>Accepted missions with a factual current state.</p></div><span class="count" data-founder-count="working-now">—</span></div>
    <div class="loading-state" data-founder-slot="working-now">Loading accepted work…</div>
  </section>
  <section class="owner-section" aria-labelledby="shipped-title">
    <div class="section-head"><div><p class="eyebrow">Delivered</p><h2 id="shipped-title">What shipped</h2><p>Completed missions backed by durable evidence.</p></div><span class="count" data-founder-count="what-shipped">—</span></div>
    <div class="loading-state" data-founder-slot="what-shipped">Loading verified outcomes…</div>
  </section>
  <section class="owner-section" aria-labelledby="changed-title">
    <div class="section-head"><div><p class="eyebrow">Since last look</p><h2 id="changed-title">What changed</h2><p>Material mission events, not raw provider activity.</p></div><span class="count" data-founder-count="what-changed">—</span></div>
    <div class="loading-state" data-founder-slot="what-changed">Loading material changes…</div>
  </section>
  <section class="owner-section" aria-labelledby="next-title">
    <div class="section-head"><div><p class="eyebrow">Consider</p><h2 id="next-title">Recommended next</h2><p>Ranked suggestions grounded in evidence and portfolio attention.</p></div><span class="count" data-founder-count="recommended-next">—</span></div>
    <div class="loading-state" data-founder-slot="recommended-next">Loading recommendations…</div>
  </section>
</FounderLayout>
