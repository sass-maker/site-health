---
import FleetNav from "./FleetNav.astro";
import "../styles/founder.css";

interface Props {
  title: string;
  description: string;
  active: "domains" | "search" | "ai-awareness" | "market" | "performance" | "project-statuses" | "feedback" | "metrics";
  eyebrow?: string;
  view?: "domains" | "search" | "ai-awareness" | "marketing" | "performance" | "project-statuses" | "project" | "metrics" | "feedback" | "mission";
  projectId?: string;
}

const { title, description, active, eyebrow = "Founder control", view, projectId } = Astro.props;
const filterable = !["project", "mission", "domains", "search", "ai-awareness", "performance"].includes(view ?? "");
const directoryView = ["domains", "search", "ai-awareness", "marketing", "performance", "project-statuses"].includes(view ?? "");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="founder-api-base" content="/api/founder" />
    <title>{title} · Foundry</title>
    <meta name="description" content={description} />
  </head>
  <body data-founder-view={view} data-project-id={projectId}>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="shell" data-sidebar-shell>
      <FleetNav active={active} />
      <button
        class="sidebar-backdrop"
        type="button"
        tabindex="-1"
        aria-label="Close navigation"
        data-sidebar-backdrop
      ></button>
      <main id="main" class:list={["main-shell", { "main-shell--directory": directoryView }]}>
        <button
          class="sidebar-mobile-toggle"
          type="button"
          aria-label="Menu"
          aria-controls="fleet-sidebar"
          aria-expanded="false"
          data-sidebar-open
        >
          <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
          <span>Menu</span>
        </button>
        <header class:list={["page-head", { "page-head--compact": directoryView }]}>
          <div>
            <p class="eyebrow">{eyebrow}</p>
            <h1>{title}</h1>
            <p class="lede">{description}</p>
          </div>
          <slot name="meta" />
        </header>
        <div class="global-status" data-founder-global-status aria-live="assertive"></div>
        {filterable && (
          <section class:list={["project-scope", { "project-scope--compact": directoryView }]} aria-label="Project scope" data-project-scope>
            <div>
              <span>Project scope</span>
              <strong data-project-scope-label>All projects</strong>
            </div>
            <label>
              <span class="sr-only">Filter this page by project</span>
              <select id="project-scope-select" name="project" data-project-scope-select>
                <option value="">All projects</option>
              </select>
            </label>
          </section>
        )}
        <slot />
      </main>
    </div>
    <script>
      import "../scripts/founder-client";
    </script>
  </body>
</html>
