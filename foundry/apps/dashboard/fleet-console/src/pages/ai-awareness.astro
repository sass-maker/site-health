---
import FounderLayout from "../components/FounderLayout.astro";
---

<FounderLayout
  title="AI awareness"
  description="Are the core products present in real model answers?"
  active="ai-awareness"
  view="ai-awareness"
>
  <div slot="meta" class="page-head__meta">
    <span class="snapshot-time" data-outcome-time>Reading provider evidence</span>
  </div>
  <section class="owner-section owner-section--directory" aria-labelledby="ai-awareness-title">
    <div class="section-head">
      <div>
        <h2 id="ai-awareness-title">Core project awareness</h2>
        <p>Provider-backed answers only. Fixtures and technical readiness do not count.</p>
      </div>
      <span class="count" data-founder-count="ai-awareness">—</span>
    </div>
    <div class="loading-state" data-founder-slot="ai-awareness">Building AI awareness view…</div>
  </section>
</FounderLayout>
