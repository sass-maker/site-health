---
import DashboardLayout from "../../components/DashboardLayout.astro";
---

<DashboardLayout
  title="Projects"
  description="Current portfolio health with the complete inactive and retained inventory kept within reach."
  active="projects"
  view="projects"
  showProjectScope={false}
>
  <div slot="meta" class="page-head__actions">
    <span class="snapshot-time" data-project-status-time>Reading project directory</span>
    <button class="primary-action" type="button" data-project-refresh-all>
      <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M20 6v5h-5 M4 18v-5h5 M18.5 9A7 7 0 006 6.5L4 9 M5.5 15A7 7 0 0018 17.5l2-2.5" /></svg>
      <span>Refresh portfolio</span>
    </button>
    <span class="refresh-status" data-project-refresh-status role="status" aria-live="polite">DRANK · Performance · Search</span>
  </div>
  <section class="portfolio-summary" aria-label="Portfolio summary" data-dashboard-slot="project-summary">
    <div class="loading-state" role="status" aria-live="polite" aria-busy="true">Reading portfolio evidence…</div>
  </section>
  <section class="directory-controls" aria-label="Project filters">
    <label class="directory-search">
      <span>Find a product</span>
      <input type="search" placeholder="Search name or domain" autocomplete="off" data-project-search />
    </label>
    <label>
      <span>Priority</span>
      <select data-project-priority>
        <option value="">All priorities</option>
        <option value="P1">P1</option>
        <option value="P2">P2</option>
        <option value="P4">P4</option>
      </select>
    </label>
    <label>
      <span>State</span>
      <select data-project-health>
        <option value="">All states</option>
        <option value="attention">Needs attention</option>
        <option value="measured">Has evidence</option>
        <option value="missing">Missing evidence</option>
        <option value="inactive">Inactive / retained</option>
      </select>
    </label>
    <button class="directory-reset" type="button" data-project-filter-reset>Clear filters</button>
    <span class="directory-result-count" data-project-result-count aria-live="polite"></span>
  </section>
  <section class="owner-section owner-section--directory" aria-labelledby="project-directory-title">
    <h2 class="sr-only" id="project-directory-title">Project directory</h2>
    <details class="directory-help">
      <summary>Status guide</summary>
      <p><strong>Fresh / observed</strong> has current evidence. <strong>Needs work / stale / zero impressions</strong> needs attention. <strong>Not measured</strong> has no observation. <strong>Unavailable</strong> means the provider could not be reached.</p>
    </details>
    <div class="loading-state" data-dashboard-slot="project-statuses" role="status" aria-live="polite" aria-busy="true">Building project directory…</div>
  </section>
</DashboardLayout>
