---
import DashboardLayout from "../components/DashboardLayout.astro";
---

<DashboardLayout
  title="Google Search"
  description="Are people finding our products through Google?"
  active="search"
  view="search"
>
  <div slot="meta" class="page-head__meta">
    <button type="button" class="secondary-action" data-portfolio-refresh="search">Update</button>
    <a class="secondary-action" href="https://search.google.com/search-console" target="_blank" rel="noreferrer">Open Search Console ↗</a>
    <span class="portfolio-refresh-status" role="status" aria-live="polite" data-portfolio-refresh-status="search"></span>
    <strong class="search-reporting-period" data-search-period>Reading reporting period</strong>
    <span class="snapshot-time" data-outcome-time>Reading Search Console evidence</span>
  </div>
  <section class="owner-section owner-section--directory" aria-label="Google Search results by project">
    <div class="loading-state" data-dashboard-slot="search">Building Google Search ledger…</div>
  </section>
  <section class="owner-section owner-section--directory" aria-labelledby="seo-audit-title">
    <div class="section-head">
      <div>
        <h2 id="seo-audit-title">On-page SEO audit</h2>
        <p>What Google can read on the page itself, independent of whether anyone has searched for it yet. A surface with zero failures was audited and passed; a surface with no audit reports no counts at all.</p>
        <p class="measurement-boundary-note" data-dashboard-coverage="seo-audit">Reading audit coverage</p>
      </div>
      <span class="count" data-dashboard-count="seo-audit">—</span>
    </div>
    <div class="loading-state" data-dashboard-slot="seo-audit">Building on-page SEO ledger…</div>
  </section>
</DashboardLayout>
