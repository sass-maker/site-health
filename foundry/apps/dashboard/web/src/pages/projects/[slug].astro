---
import DashboardLayout from "../../components/DashboardLayout.astro";
import { getFleetProjects } from "../../lib/fleet-data";

export function getStaticPaths() {
  return getFleetProjects().map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
---

<DashboardLayout
  title={project.title}
  description="Current state, changelog, and measurable SEO, GEO, and performance outcomes."
  active="projects"
  view="project"
  projectId={project.slug}
>
  <section class="owner-section" aria-labelledby="project-control-title">
    <div class="section-head">
      <div>
        <p class="eyebrow">Product control loop</p>
        <h2 id="project-control-title">Current state</h2>
        <p>Canonical identity stays in the project registry. Dashboard shows only owner-relevant projections.</p>
      </div>
    </div>
    <div class="loading-state" data-dashboard-slot="project-detail">Loading project evidence…</div>
  </section>
</DashboardLayout>
