---
import { PACKAGE_HOST } from '../data/links';

const PACKAGE_SPEC: Array<[string, string]> = [
  ['Package', '@saas-maker/feedback'],
  ['Runtime', 'React 19'],
  ['Input', 'A required onSubmit callback'],
  ['Feedback', 'Bug · feature request · general'],
  ['Attachments', 'JPEG · PNG · GIF · WebP'],
  ['Network', 'Consumer-owned · no default endpoint'],
  ['Docs', PACKAGE_HOST],
];

const TERMINAL = `$ pnpm add @saas-maker/feedback

import { FeedbackWidget } from '@saas-maker/feedback'

export function App() {
  return <FeedbackWidget onSubmit={saveFeedback} />
}`;
---
<section class="section" id="spec">
  <div class="section-head">
    <div class="section-marker">
      <span class="section-num">§ 02</span>
      <span class="section-rule"></span>
      <span class="section-kw">The Package</span>
    </div>
    <h2 class="section-title">
      One focused way
      <br />
      to collect <em class="italic">feedback</em>.
    </h2>
    <p class="section-lede">
      SaaS Maker publishes a small React widget for bugs, feature requests,
      screenshots, and page-specific feedback. It performs no implicit network
      request: the integrating product decides where submissions go.
    </p>
  </div>

  <div class="spec-layout">
    <div class="spec-sheet">
      <div class="spec-head">
        <span class="spec-stamp">PACKAGE NOTES</span>
        <span class="spec-rule"></span>
      </div>
      <dl>
        {PACKAGE_SPEC.map(([key, value]) => (
          <div class="spec-row">
            <dt>{key}</dt>
            <dd>{value}</dd>
          </div>
        ))}
      </dl>
      <div class="spec-foot">
        <span class="spec-rule"></span>
        <span class="spec-stamp">END · FOLIO 01</span>
      </div>
    </div>

    <div class="terminal">
      <div class="terminal-head">
        <span class="t-dot t-r"></span>
        <span class="t-dot t-y"></span>
        <span class="t-dot t-g"></span>
        <span class="terminal-title">feedback-widget.tsx</span>
      </div>
      <pre class="terminal-body">{TERMINAL}</pre>
    </div>
  </div>
</section>
