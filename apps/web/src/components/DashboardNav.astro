---
import "../styles/dashboard.css";

interface Props {
  active: "domains" | "search" | "ai-awareness" | "performance" | "projects";
}

const { active } = Astro.props;
const links = [
  { id: "domains", href: "/domains", label: "Domains", icon: "M3 12h18 M12 3a15 15 0 010 18 M12 3a15 15 0 000 18 M4.8 7.5h14.4 M4.8 16.5h14.4" },
  { id: "search", href: "/search", label: "Google Search", icon: "M11 4a7 7 0 105.2 11.7L21 20.5 M8 11h6 M11 8v6" },
  { id: "ai-awareness", href: "/ai-awareness", label: "AI awareness", icon: "M12 3v3 M12 18v3 M3 12h3 M18 12h3 M5.6 5.6l2.1 2.1 M16.3 16.3l2.1 2.1 M18.4 5.6l-2.1 2.1 M7.7 16.3l-2.1 2.1 M9 12a3 3 0 106 0 3 3 0 00-6 0z" },
  { id: "performance", href: "/performance", label: "Performance", icon: "M4 17a8 8 0 1116 0 M12 17l4-5 M7 17h10" },
] as const;
const secondaryLinks = [
  { id: "projects", href: "/projects", label: "Projects", icon: "M4 6h7v5H4z M13 6h7v5h-7z M4 13h7v5H4z M13 13h7v5h-7z" },
] as const;
---

<aside class="dashboard-sidebar" id="dashboard-sidebar" aria-label="Site Health navigation">
  <div class="sidebar-head">
    <a class="brand" href="/domains" data-project-scope-link>
      <span class="brand-mark" aria-hidden="true">S</span>
      <span class="sidebar-copy"><strong>Site Health</strong><small>Owner view</small></span>
    </a>
    <button
      class="sidebar-collapse"
      type="button"
      aria-label="Collapse sidebar"
      aria-expanded="true"
      data-sidebar-collapse
    >
      <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M14 6l-6 6 6 6M19 4v16" /></svg>
    </button>
    <button class="sidebar-close" type="button" aria-label="Close navigation" data-sidebar-close>
      <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M6 6l12 12M18 6L6 18" /></svg>
    </button>
  </div>

  <nav class="sidebar-nav" aria-label="Primary">
    <span class="sidebar-group-label sidebar-copy">Metrics</span>
    {links.map((link) => (
      <a
        aria-current={active === link.id ? "page" : undefined}
        class:list={{ active: active === link.id }}
        href={link.href}
        title={link.label}
        data-project-scope-link
      >
        <svg aria-hidden="true" viewBox="0 0 24 24"><path d={link.icon} /></svg>
        <span class="sidebar-copy">{link.label}</span>
      </a>
    ))}
    <span class="sidebar-group-divider" aria-hidden="true"></span>
    {secondaryLinks.map((link) => (
      <a
        aria-current={active === link.id ? "page" : undefined}
        class:list={{ active: active === link.id }}
        href={link.href}
        title={link.label}
        data-project-scope-link
      >
        <svg aria-hidden="true" viewBox="0 0 24 24"><path d={link.icon} /></svg>
        <span class="sidebar-copy">{link.label}</span>
      </a>
    ))}
  </nav>

  <div class="sidebar-foot">
    <span class="connection" data-dashboard-connection role="status" aria-live="polite">
      <i aria-hidden="true"></i>
      <span class="sidebar-copy" data-dashboard-connection-label>Connecting</span>
    </span>
    <a
      class="repo-link"
      href="https://github.com/sass-maker/site-health"
      aria-label="GitHub repository"
      title="GitHub repository"
      target="_blank"
      rel="noopener noreferrer"
    >
      <svg aria-hidden="true" viewBox="0 0 16 16" width="20" height="20" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z" /></svg>
    </a>
  </div>
</aside>

<script>
  const shell = document.querySelector<HTMLElement>("[data-sidebar-shell]");
  const collapse = document.querySelector<HTMLButtonElement>("[data-sidebar-collapse]");
  const opener = document.querySelector<HTMLButtonElement>("[data-sidebar-open]");
  const close = document.querySelector<HTMLButtonElement>("[data-sidebar-close]");
  const sidebar = document.querySelector<HTMLElement>("#dashboard-sidebar");
  const backdrop = document.querySelector<HTMLButtonElement>("[data-sidebar-backdrop]");
  const main = document.querySelector<HTMLElement>("#main");
  const indicator = document.querySelector<HTMLElement>("[data-dashboard-connection]");
  const label = document.querySelector<HTMLElement>("[data-dashboard-connection-label]");
  const mobile = window.matchMedia("(max-width: 850px)");
  let returnFocus: HTMLElement | null = null;

  function setCollapsed(collapsed: boolean) {
    shell?.classList.toggle("sidebar-collapsed", collapsed);
    collapse?.setAttribute("aria-expanded", String(!collapsed));
    collapse?.setAttribute("aria-label", collapsed ? "Expand sidebar" : "Collapse sidebar");
    try { localStorage.setItem("dashboard-sidebar-collapsed", String(collapsed)); } catch {}
  }

  function setOpen(open: boolean, restoreFocus = true) {
    const isMobile = mobile.matches;
    const shouldOpen = isMobile && open;
    shell?.classList.toggle("sidebar-open", shouldOpen);
    opener?.setAttribute("aria-expanded", String(shouldOpen));
    if (isMobile) {
      document.querySelector<HTMLElement>("#dashboard-sidebar")?.toggleAttribute("inert", !shouldOpen);
      document.querySelector<HTMLElement>("#dashboard-sidebar")?.setAttribute("aria-hidden", String(!shouldOpen));
      main?.toggleAttribute("inert", shouldOpen);
    } else {
      document.querySelector<HTMLElement>("#dashboard-sidebar")?.removeAttribute("inert");
      document.querySelector<HTMLElement>("#dashboard-sidebar")?.removeAttribute("aria-hidden");
      main?.removeAttribute("inert");
    }
    if (shouldOpen) {
      returnFocus = document.activeElement instanceof HTMLElement ? document.activeElement : opener;
      close?.focus();
    } else if (restoreFocus && returnFocus) {
      returnFocus?.focus();
      returnFocus = null;
    }
  }

  try { setCollapsed(localStorage.getItem("dashboard-sidebar-collapsed") === "true"); } catch {}
  setOpen(false, false);
  collapse?.addEventListener("click", () => setCollapsed(!shell?.classList.contains("sidebar-collapsed")));
  opener?.addEventListener("click", () => setOpen(true));
  close?.addEventListener("click", () => setOpen(false));
  backdrop?.addEventListener("click", () => setOpen(false));
  mobile.addEventListener("change", () => setOpen(false, false));
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && shell?.classList.contains("sidebar-open")) setOpen(false);
    if (event.key !== "Tab" || !shell?.classList.contains("sidebar-open") || !sidebar) return;
    const focusable = [...sidebar.querySelectorAll<HTMLElement>(
      'a[href], button:not([disabled]), select:not([disabled]), [tabindex]:not([tabindex="-1"])',
    )].filter((item) => !item.hasAttribute("inert"));
    const first = focusable[0];
    const last = focusable.at(-1);
    if (!first || !last) return;
    if (event.shiftKey && document.activeElement === first) {
      event.preventDefault();
      last.focus();
    } else if (!event.shiftKey && document.activeElement === last) {
      event.preventDefault();
      first.focus();
    }
  });

  if (document.body.dataset.dashboardEvidence === "false") {
    if (label) label.textContent = "Local gallery";
  } else {
    fetch("/api/dashboard/health", { headers: { accept: "application/json" } })
      .then((response) => {
        if (!response.ok) throw new Error("offline");
        if (indicator?.dataset.dashboardEvidenceState) return;
        indicator?.classList.remove("offline");
        indicator?.classList.add("online");
        if (label) label.textContent = "Live evidence";
      })
      .catch(() => {
        if (indicator?.dataset.dashboardEvidenceState) return;
        indicator?.classList.remove("online");
        indicator?.classList.add("offline");
        if (label) label.textContent = "Offline";
      });
  }
</script>
