---
import FounderLayout from "../components/FounderLayout.astro";
---

<FounderLayout
  title="Domains"
  description="Is every owned domain becoming more authoritative?"
  active="domains"
  view="domains"
>
  <div slot="meta" class="page-head__meta">
    <button type="button" class="secondary-action" data-domain-refresh>Re-run</button>
    <span class="domain-refresh-status" role="status" aria-live="polite" data-domain-refresh-status></span>
    <span class="snapshot-time" data-outcome-time>Reading domain evidence</span>
  </div>
  <section class="owner-section owner-section--directory" aria-label="Domain directory">
    <div class="loading-state" data-founder-slot="domains">Building domain directory…</div>
  </section>
</FounderLayout>
